    "dev:daemon": "tsx src/daemon/daemon-entry.ts",
    "test": "tsx tests/audio-engine-test.ts",
    "pujangga": "node ./bin/pujangga"
  },
  "keywords": [
    "agent",
    "skill",
    "review",
    "editorial",
    "writing",
    "markdown",
    "human-in-the-loop"
